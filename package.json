{
  "name": "plaud-dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "PLAUD internal DeepSeek Harness plugins — OAuth-capable MCP connectors for Notion, Linear, Slack, PLAUD and Feishu/Lark",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "pack:all": "pnpm -r exec npm pack --pack-destination ../../dist",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}

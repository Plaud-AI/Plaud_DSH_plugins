# Host environment for the PLAUD DSH connectors.
# Copy to `.env` and fill in — never commit real values.

# --- Notion / Linear -------------------------------------------------------
# Nothing to set: both support Dynamic Client Registration, so the browser
# flow registers the client on first use.

# --- Slack -----------------------------------------------------------------
# Requires a Slack app (api.slack.com/apps) with MCP enabled. No DCR.
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
SLACK_MCP_APP_ID=

# --- PLAUD internal MCP ----------------------------------------------------
PLAUD_MCP_URL=
PLAUD_MCP_TOKEN=

# --- Feishu / Lark ---------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: where credentials are cached (defaults to ~/.dsh/mcp-oauth)
# DSH_HOME=

{
  "name": "@plaudai/dsh-plugin-slackbot",
  "version": "0.2.1",
  "description": "Slack 原生工具：读频道历史、线程与全文搜索，可选发消息；Socket Mode 收消息，无需公网回调",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plaud-AI/Plaud_DSH_plugins.git",
    "directory": "packages/slackbot"
  },
  "homepage": "https://github.com/Plaud-AI/Plaud_DSH_plugins/tree/main/packages/slackbot",
  "bugs": {
    "url": "https://github.com/Plaud-AI/Plaud_DSH_plugins/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "slack",
    "socket-mode",
    "notify"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
